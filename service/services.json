{
	"id": "com.stark.bluesky.service",
	"description": "Saves pictures and relays video for the Bluesky app",
	"engine": "node",
	"activityTimeout": 120,
	"services": [
		{
			"name": "com.stark.bluesky.service",
			"globalized": false,
			"commands": [
				{ "name": "save", "assistant": "saveAssistant", "public": true },
				{ "name": "video", "assistant": "videoAssistant", "public": true },
				{ "name": "ping", "assistant": "pingAssistant", "public": true }
			]
		}
	]
}
